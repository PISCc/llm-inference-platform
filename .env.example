# Optional deployment defaults for the online model service.
# A user session configured in the UI takes priority; .env is only a deployment/development fallback.
# The recommended public default is OpenAI's Chat Completions endpoint.
# Fill LLM_API_KEY with the deployment owner's server-side key; never put it in VITE_* variables.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_PROVIDER=openai-compatible

# Generation and timeout controls.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=60000

# Public shared-default protection. Custom session APIs are not charged to this shared quota.
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_REQUESTS=12
AGENT_RATE_LIMIT_WINDOW_MS=600000
AGENT_DEFAULT_DAILY_LIMIT=700
AGENT_DEFAULT_DAILY_WINDOW_MS=86400000

# At least 32 random characters. Encrypts per-session custom model settings across serverless functions.
MODEL_CONFIG_SECRET=

# Public deployments reject HTTP and private-network model endpoints by default.
# Enable both only for trusted local development, never on a public deployment.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
ALLOW_INSECURE_MODEL_ENDPOINTS=false

# Comma-separated production origins allowed to call the API.
AGENT_ALLOWED_ORIGIN=

# Allow file:// pages (which send Origin: null) to call this API.
# Local dev servers enable this automatically; set to true only when you
# also want the same behavior on hosted deployments (Vercel / Render).
AGENT_ALLOW_FILE_ORIGIN=false

# Local API development server.
AGENT_DEV_HOST=127.0.0.1
AGENT_DEV_PORT=8787

# Vite client override for the agent API. Leave empty so production builds call same-origin /api.
# Only set this when the API is served from a different origin than the frontend.
VITE_AGENT_API_URL=
