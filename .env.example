# Optional deployment defaults for the online model service.
# A user session configured in the UI takes priority; .env is only a deployment/development fallback.
# The recommended public default is Groq's OpenAI-compatible endpoint.
# Fill LLM_API_KEY with the deployment owner's server-side key; never put it in VITE_* variables.
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b
LLM_PROVIDER=groq

# Generation and timeout controls.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=60000

# Public shared-default protection. Custom session APIs are not charged to this shared quota.
AGENT_RATE_LIMIT_ENABLED=true
AGENT_RATE_LIMIT_REQUESTS=12
AGENT_RATE_LIMIT_WINDOW_MS=600000
AGENT_DEFAULT_DAILY_LIMIT=700
AGENT_DEFAULT_DAILY_WINDOW_MS=86400000

# knowledge-to-ppt uses the presentation runtime on the server.
# The local Codex bundled runtime is detected automatically; deployment paths can override it below.
# Never expose these paths to the browser.
PPT_RUNTIME_NODE=
PPT_RUNTIME_NODE_MODULES=
PPT_RUNTIME_BIN_DIR=

# Optional strict overflow check after rendering.
PPT_QA_PYTHON=
PPT_SLIDES_TEST=

# Comma-separated production origins allowed to call the API.
AGENT_ALLOWED_ORIGIN=

# Local API development server.
AGENT_DEV_HOST=127.0.0.1
AGENT_DEV_PORT=8787

# Vite client override for local development.
VITE_AGENT_API_URL=http://127.0.0.1:8787/api/agent/chat
